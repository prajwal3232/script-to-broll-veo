# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Model used for all LLM steps. Override if you have access to another tier.
GEMINI_MODEL=gemini-3.1-pro-preview

# --- Veo (text-to-video, step 6) ---
# Default model. Uses the same GEMINI_API_KEY above (Veo is a paid feature).
# Options: veo-3.1-lite-generate-preview (cheapest), veo-3.1-fast-generate-preview,
#          veo-3.1-generate-preview, veo-3.0-fast-generate-001, veo-3.0-generate-001
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_ASPECT_RATIO=9:16
# Pass a fixed seed to Veo for repeatable output. ONLY works on Vertex AI /
# Gemini Enterprise — the Developer API (plain API key) rejects it. Leave off
# unless you run against Vertex. Consistency does not depend on it.
VEO_USE_SEED=

# --- Server ---
HOST=127.0.0.1
PORT=5000

# --- Azure Blob Storage (for generated videos) ---
# Leave all blank to disable Azure upload.
# Preferred: a container-level SAS URL. Videos go under AZURE_BLOB_PREFIX in a
# unique per-run sub-folder (the job id).
#   https://<account>.blob.core.windows.net/<container>?sp=racwl&st=...&sig=...
AZURE_BLOB_SAS_URL=
AZURE_BLOB_PREFIX=hogel-brolls/testing

# Fallback: full connection string (used only if SAS URL is blank).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=generated-videos
